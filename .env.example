# Copy this file to .env (in the project root) and fill in your own values.
# Used by docker compose to create the local Postgres database.
# Never commit .env (it's in .gitignore).

POSTGRES_USER=talaan
POSTGRES_PASSWORD=pick_a_password
POSTGRES_DB=talaan

# Only for "docker compose up" (the whole app in Docker): signs the login cookies.
# Any long random string: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# The API's own settings for local development are in apps/api/.env (see apps/api/.env.example).
