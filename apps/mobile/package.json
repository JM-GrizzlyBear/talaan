{
  "name": "@talaan/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build:shared": "pnpm --filter @talaan/shared build",
    "start": "pnpm run build:shared && expo start",
    "android": "pnpm run build:shared && expo start --android",
    "ios": "pnpm run build:shared && expo start --ios",
    "web": "pnpm run build:shared && expo start --web",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "pnpm run build:shared && expo export --platform android --platform ios --output-dir .expo-export"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.15",
    "@noble/ciphers": "1.3.0",
    "@talaan/shared": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "expo": "58.0.21",
    "expo-application": "58.1.2",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-image": "58.0.18",
    "expo-linking": "58.0.15",
    "expo-local-authentication": "58.0.2",
    "expo-router": "58.0.28",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
