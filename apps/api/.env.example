# Copy this file to apps/api/.env and fill in your own values.
# Never commit apps/api/.env (it's in .gitignore).

PORT=4000

# Local Postgres from docker compose. Same user, password and database as the root .env.
DATABASE_URL=postgres://talaan:pick_a_password@127.0.0.1:5432/talaan?sslmode=disable

# Signs the login cookies and keys the emailed code hashes.
# Any long random string: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Forgot-password and two-step sign-in emails. Locally they go to Mailpit (docker compose up -d mail)
# and show up at http://localhost:8025. Leave SMTP_HOST empty to turn email off:
# Forgot password then answers that email isn't set up yet.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Talaan <no-reply@talaan.local>
# The website's address (no "/" at the end): links in emails, and passkeys
# belong to it. Open the site at exactly this address, or passkeys won't work.
APP_URL=http://localhost:5173
# Mailpit needs no login: leave these two empty locally.
SMTP_USER=
SMTP_PASS=

# Without SMTP_HOST, two-step sign-in is skipped (it can't send codes).

# Live site only (Render → Environment), with Brevo (README → "Sending emails"):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=2525   (Render's free plan blocks 25, 465 and 587)
#   SMTP_USER=xxxxxx@smtp-brevo.com   (Brevo's SMTP login, not your Gmail)
#   SMTP_PASS=your-brevo-smtp-key
#   MAIL_FROM=Talaan <the-gmail-you-verified-on-brevo@gmail.com>
#   APP_URL=https://your-site.netlify.app

# How many proxies sit in front of the API, so rate limits see each visitor's
# real IP address. Locally: 0 (the default). Render alone: 1. Netlify, then Render: 2.
# TRUST_PROXY=0

# Photos and PDFs on records (README → "Storing photos and PDFs").
# Leave CLOUDINARY_URL empty locally to keep uploads in apps/api/.uploads instead.
# On the live site it's required, or uploading is off.
#   CLOUDINARY_URL=cloudinary://<api key>:<api secret>@<cloud name>
#   CLOUDINARY_FOLDER=talaan-dev   (your computer; the live site uses talaan)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=talaan-dev
